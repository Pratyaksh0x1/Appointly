{
  "name": "appointly",
  "version": "1.0.0",
  "description": "Hinglish live voice agent for small clinics with real-time doctor dashboard and zero double-booking on Neon PostgreSQL.",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest",
    "lint": "npm run typecheck && npm run format:check",
    "format": "prettier --write \"**/*.{ts,json,md,html}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,html}\"",
    "dev": "npm run dev --workspace=@appointly/api",
    "start": "npm run start --workspace=@appointly/api",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "smoke:voice": "tsx scripts/smoke-voice-pipeline.ts",
    "chat:cli": "tsx scripts/cli-chat.ts",
    "audit": "npm audit --audit-level=high"
  },
  "keywords": [
    "gnani-ai",
    "voice-agent",
    "hinglish",
    "clinic-booking",
    "doctor-dashboard",
    "prisma",
    "timbre",
    "evon-30b",
    "neon-postgres"
  ],
  "author": "Appointly Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4"
  }
}
