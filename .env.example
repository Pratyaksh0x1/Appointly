# Gnani.ai API Configuration
# Get your API key from https://app.gnani.ai/voice/
GNANI_API_KEY=your_gnani_api_key_here

# STT Configuration
# Models: prisma-v3.0, prisma-v2.5
# Languages: indic-auto, hi-IN, en-IN, kn-IN, ta-IN, te-IN, mr-IN, bn-IN, gu-IN, etc.
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=indic-auto

# TTS Configuration
# Models: timbre-v3.0, timbre-v2.5
# Timbre v3.0 Voices: Avinash, Chetana, Devansh, Harshad, Kalpana, Lakshmi, Prakash, Riyaa, Shivani, Shubham, Tarika, Vasudha, Yashraj
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_LANGUAGE=hi-IN
GNANI_TTS_SPEED=1.0

# Optional: LLM Configuration for Clinic Agent Dialogue
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
