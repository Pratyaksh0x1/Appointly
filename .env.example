# ==============================================================================
# Appointly - Hinglish Voice Agent & Doctor Dashboard Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration
# In development/testing, set USE_IN_MEMORY_DB=true if no local Postgres daemon is available.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/appointly
USE_IN_MEMORY_DB=true

# Gnani.ai Speech APIs (https://docs.gnani.ai)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_MODEL=prisma-v3.0
GNANI_STT_LANGUAGE=indic-auto

# Gnani Timbre TTS (beta)
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_SSE_URL=https://api.vachana.ai/api/v1/tts/sse
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani
GNANI_TTS_LANGUAGE=hi-IN
GNANI_TTS_SPEED=1.0

# Evon 30B LLM (Gnani open-weight Indic foundational model)
# TODO(verify): Verify exact Gnani Evon 30B chat completion endpoint URL, model identifier string, and auth headers
EVON_API_KEY=your_evon_api_key_here
EVON_BASE_URL=https://api.vachana.ai/v1
EVON_MODEL=evon-30b

# Cost & Credit Management (5,000 API Credits Hackathon Budget)
# Set USE_MOCK_SERVICES=true during unit tests and local iteration to preserve credits!
USE_MOCK_SERVICES=true
TOTAL_CREDIT_BUDGET=5000
PER_CALL_CREDIT_LIMIT=50
DAILY_CREDIT_LIMIT=2000

# Retries and Timeouts (milliseconds)
HTTP_TIMEOUT_MS=8000
MAX_RETRIES=3
BACKOFF_BASE_MS=500
